{
  "manifest_version": 3,
  "name": "Fingerprint Damper",
  "version": "1.4.0",
  "description": "Blunts browser fingerprinting and push-notification ad SDKs at the JavaScript API level. Complements, rather than duplicates, an ad blocker.",

  "browser_specific_settings": {
    "gecko": {
      "id": "fingerprint-damper@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "permissions": [
    "storage",
    "declarativeNetRequest",
    "tabs"
  ],

  "host_permissions": ["<all_urls>"],

  "background": {
    "scripts": ["src/background.js"]
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "ISOLATED"
    }
  ],

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "adnets",
        "enabled": true,
        "path": "rules/adnets.json"
      }
    ]
  },

  "action": {
    "default_title": "Fingerprint Damper",
    "default_popup": "src/popup.html",
    "default_icon": "icons/icon.svg"
  },

  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": false
  },

  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}